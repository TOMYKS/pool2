[gd_scene format=3]

[sub_resource type="GDScript" id="GDScript_recuperacion"]
script/source = "extends \"res://scripts/grandes.gd\"\n\n# Medidas del paño y las bandas de mesa.tscn, en coordenadas de Sala.\nconst ALTURA_PANO := 4.1761234\nconst ALTURA_BANDA := 4.405\nconst LIMITE_PANO := Vector2(4.90, 2.42)\nconst LIMITE_EXTERIOR := Vector2(5.95, 3.65)\n\nvar _sala: Node3D\nvar _area_caidas: Area3D\nvar _caida_original: Callable\nvar _pendientes: Dictionary = {}\n\n\nfunc _ready() -> void:\n\t_sala = get_parent() as Node3D\n\t_area_caidas = _sala.get_node_or_null(\"Area3D\") as Area3D\n\tif _area_caidas == null:\n\t\treturn\n\t_caida_original = Callable(_sala, \"_on_area_3d_body_entered\")\n\t# Interceptamos solo en esta instancia; el archivo de Sala no cambia.\n\tif _area_caidas.body_entered.is_connected(_caida_original):\n\t\t_area_caidas.body_entered.disconnect(_caida_original)\n\t_area_caidas.body_entered.connect(_al_caer)\n\n\nfunc _exit_tree() -> void:\n\tif is_instance_valid(_area_caidas):\n\t\tif _area_caidas.body_entered.is_connected(_al_caer):\n\t\t\t_area_caidas.body_entered.disconnect(_al_caer)\n\t\tif _caida_original.is_valid() and not _area_caidas.body_entered.is_connected(_caida_original):\n\t\t\t_area_caidas.body_entered.connect(_caida_original)\n\n\nfunc _physics_process(_delta: float) -> void:\n\tfor id in _pendientes.keys():\n\t\tvar pendiente = _pendientes[id]\n\t\tif is_instance_valid(pendiente):\n\t\t\t_reponer(pendiente)\n\t\telse:\n\t\t\t_pendientes.erase(id)\n\tif not powerup_grandes_activo:\n\t\treturn\n\tfor nodo in get_tree().get_nodes_in_group(\"bolas_color\"):\n\t\tvar bola := nodo as RigidBody3D\n\t\tif bola != null and not bola.is_queued_for_deletion() and not _pendientes.has(bola.get_instance_id()):\n\t\t\tif _fuera_de_mesa(bola):\n\t\t\t\t_reponer(bola)\n\n\nfunc _fuera_de_mesa(bola: RigidBody3D) -> bool:\n\tvar pos := _sala.to_local(bola.global_position)\n\tif absf(pos.x) > LIMITE_EXTERIOR.x or absf(pos.z) > LIMITE_EXTERIOR.y:\n\t\treturn true\n\t# Cruzar el borde por encima de la banda es una salida, no una tronera.\n\tvar fuera_pano := absf(pos.x) > LIMITE_PANO.x or absf(pos.z) > LIMITE_PANO.y\n\treturn fuera_pano and pos.y - _radio(bola) > ALTURA_BANDA\n\n\nfunc _radio(bola: RigidBody3D) -> float:\n\tfor hijo in bola.get_children():\n\t\tif hijo is CollisionShape3D and hijo.shape is SphereShape3D:\n\t\t\treturn hijo.shape.radius\n\treturn 0.14\n\n\nfunc _al_caer(body: Node3D) -> void:\n\tif body is RigidBody3D and body.is_in_group(\"bolas_color\"):\n\t\tif _pendientes.has(body.get_instance_id()):\n\t\t\treturn\n\t\tif powerup_grandes_activo and _fuera_de_mesa(body):\n\t\t\t# La señal ocurre durante la física: cambiar la posición después.\n\t\t\t_pendientes[body.get_instance_id()] = body\n\t\t\t_reponer.call_deferred(body)\n\t\t\treturn\n\t# Blanca, troneras y power-up apagado mantienen la lógica anterior.\n\tif _caida_original.is_valid():\n\t\t_caida_original.call(body)\n\n\nfunc _reponer(bola: RigidBody3D) -> void:\n\tif not is_instance_valid(bola) or bola.is_queued_for_deletion():\n\t\treturn\n\tvar radio := _radio(bola)\n\tvar esfera := SphereShape3D.new()\n\tesfera.radius = radio\n\tvar consulta := PhysicsShapeQueryParameters3D.new()\n\tconsulta.shape = esfera\n\tconsulta.collision_mask = bola.collision_mask\n\tconsulta.exclude = [bola.get_rid()]\n\tconsulta.margin = 0.015\n\tvar espacio := bola.get_world_3d().direct_space_state\n\t# Buscamos en el interior, lejos de las bandas y las troneras.\n\t# La consulta incluye la blanca y el tamaño actual de las demás bolas.\n\tfor fila in range(5):\n\t\tfor columna in range(11):\n\t\t\tvar posicion := _sala.to_global(Vector3(\n\t\t\t\t-4.0 + columna * 0.8,\n\t\t\t\tALTURA_PANO + radio + 0.04,\n\t\t\t\t-1.6 + fila * 0.8\n\t\t\t))\n\t\t\tconsulta.transform = Transform3D(Basis.IDENTITY, posicion)\n\t\t\tif espacio.intersect_shape(consulta, 1).is_empty():\n\t\t\t\tbola.linear_velocity = Vector3.ZERO\n\t\t\t\tbola.angular_velocity = Vector3.ZERO\n\t\t\t\tbola.global_position = posicion\n\t\t\t\tbola.freeze = false\n\t\t\t\tbola.sleeping = false\n\t\t\t\t_pendientes.erase(bola.get_instance_id())\n\t\t\t\tprint(\"Bola grande fuera: vuelve a un lugar libre de la mesa.\")\n\t\t\t\treturn\n\t# Si no hay sitio, conservamos la bola fuera y reintentamos.\n\tbola.linear_velocity = Vector3.ZERO\n\tbola.angular_velocity = Vector3.ZERO\n\tbola.freeze = true\n\t_pendientes[bola.get_instance_id()] = bola\n"

[node name="Grandes" type="Node3D"]
script = SubResource("GDScript_recuperacion")
